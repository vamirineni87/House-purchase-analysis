<section class="section" id="appraisal">
  <h2 class="section-title">Appraisal Analysis</h2>

  {# ---- Value Assessment ---- #}
  <div class="card-grid">
    <div class="card card-wide">
      <span class="card-label">Value Assessment</span>
      <span class="card-value">
        {% if results.appraisal.value_assessment == "below_market" %}
          <span class="badge badge-positive">Below Market</span>
        {% elif results.appraisal.value_assessment == "at_market" %}
          <span class="badge badge-neutral">At Market</span>
        {% else %}
          <span class="badge badge-negative">Above Market</span>
        {% endif %}
      </span>
      <span class="card-detail">Confidence: {{ results.appraisal.confidence | title }}</span>
    </div>
  </div>

  {# ---- Estimated Value Range ---- #}
  <h3>Estimated Value Range</h3>
  <div class="card-grid">
    <div class="card">
      <span class="card-label">Low Estimate</span>
      <span class="card-value">{{ results.appraisal.estimated_value_low | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Mid Estimate</span>
      <span class="card-value card-value-highlight">{{ results.appraisal.estimated_value_mid | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">High Estimate</span>
      <span class="card-value">{{ results.appraisal.estimated_value_high | currency }}</span>
    </div>
  </div>

  {# ---- Price per Sqft Comparison ---- #}
  <h3>Price per Square Foot</h3>
  <div class="card-grid">
    <div class="card">
      <span class="card-label">Subject Property</span>
      <span class="card-value">{{ results.appraisal.subject_price_per_sqft | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Market Average</span>
      <span class="card-value">{{ results.appraisal.price_per_sqft_market | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Difference</span>
      {% set diff = results.appraisal.subject_price_per_sqft - results.appraisal.price_per_sqft_market %}
      <span class="card-value {% if diff < 0 %}text-positive{% elif diff > 0 %}text-negative{% endif %}">
        {{ diff | currency }} / sqft
      </span>
    </div>
  </div>

  {# ---- Comparable Sales ---- #}
  {% if results.appraisal.comparables %}
  <h3>Comparable Sales</h3>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Address</th>
          <th>Sale Price</th>
          <th>Sqft</th>
          <th>Beds/Baths</th>
          <th>$/Sqft</th>
          <th>Distance</th>
          <th>Adjusted Price</th>
        </tr>
      </thead>
      <tbody>
        {% for comp in results.appraisal.comparables %}
        <tr>
          <td>{{ comp.address.street }}, {{ comp.address.city }}</td>
          <td>{{ comp.sale_price | currency }}</td>
          <td>{{ comp.square_feet | number }}</td>
          <td>{{ comp.bedrooms }} / {{ comp.bathrooms | number(1) }}</td>
          <td>{{ comp.price_per_sqft | currency }}</td>
          <td>{{ comp.distance_miles | number(1) }} mi</td>
          <td>
            {% if comp.adjusted_price is not none %}
              {{ comp.adjusted_price | currency }}
            {% else %}
              --
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>
