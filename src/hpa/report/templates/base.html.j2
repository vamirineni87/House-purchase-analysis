<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Purchase Analysis - {{ property.address.street }}</title>
  <style>{{ css }}</style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Home Purchase Analysis Report</h1>
      <p class="subtitle">{{ property.address.street }}, {{ property.address.city }}, {{ property.address.state }} {{ property.address.zip_code }}</p>
      <p class="date">Generated {{ generated_at }}</p>
    </header>

    <main>
      {% include "summary.html.j2" %}

      {% if results.financial %}
      {% include "financial.html.j2" %}
      {% endif %}

      {% if results.appraisal %}
      {% include "appraisal.html.j2" %}
      {% endif %}

      {% if results.neighborhood %}
      {% include "neighborhood.html.j2" %}
      {% endif %}

      {% if results.tax %}
      {% include "tax.html.j2" %}
      {% endif %}

      {% if results.insurance %}
      {% include "insurance.html.j2" %}
      {% endif %}

      {% if results.investment %}
      {% include "investment.html.j2" %}
      {% endif %}
    </main>

    <footer>
      <p>Generated by Home Purchase Analysis Tool v0.1.0</p>
      <p class="disclaimer">This report is for informational purposes only and does not constitute financial, legal, or real estate advice. Consult qualified professionals before making purchase decisions.</p>
    </footer>
  </div>
</body>
</html>
