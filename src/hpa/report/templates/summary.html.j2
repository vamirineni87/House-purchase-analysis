<section class="section" id="summary">
  <h2 class="section-title">Property Overview</h2>

  <div class="card-grid">
    <div class="card">
      <span class="card-label">List Price</span>
      <span class="card-value">{{ property.list_price | currency }}</span>
    </div>

    <div class="card">
      <span class="card-label">Price per Sqft</span>
      <span class="card-value">
        {% if property.square_feet > 0 %}
          {{ (property.list_price / property.square_feet) | currency }}
        {% else %}
          N/A
        {% endif %}
      </span>
    </div>

    <div class="card">
      <span class="card-label">Beds / Baths</span>
      <span class="card-value">{{ property.bedrooms }} bd / {{ property.bathrooms | number(1) }} ba</span>
    </div>

    <div class="card">
      <span class="card-label">Square Feet</span>
      <span class="card-value">{{ property.square_feet | number }} sqft</span>
    </div>

    <div class="card">
      <span class="card-label">Year Built</span>
      <span class="card-value">{{ property.year_built if property.year_built else "N/A" }}</span>
    </div>

    <div class="card">
      <span class="card-label">Property Type</span>
      <span class="card-value">{{ property.property_type | replace("_", " ") | title }}</span>
    </div>

    <div class="card">
      <span class="card-label">HOA</span>
      <span class="card-value">
        {% if property.hoa_monthly > 0 %}
          {{ property.hoa_monthly | currency }} / mo
        {% else %}
          None
        {% endif %}
      </span>
    </div>

    <div class="card">
      <span class="card-label">Lot Size</span>
      <span class="card-value">
        {% if property.lot_size_sqft %}
          {{ property.lot_size_sqft | number }} sqft
        {% else %}
          N/A
        {% endif %}
      </span>
    </div>

    <div class="card">
      <span class="card-label">Garage</span>
      <span class="card-value">
        {% if property.garage_spaces > 0 %}
          {{ property.garage_spaces }}-car
        {% else %}
          None
        {% endif %}
      </span>
    </div>

    {% if property.days_on_market is not none %}
    <div class="card">
      <span class="card-label">Days on Market</span>
      <span class="card-value">{{ property.days_on_market }}</span>
    </div>
    {% endif %}

    {% if property.mls_number %}
    <div class="card">
      <span class="card-label">MLS #</span>
      <span class="card-value">{{ property.mls_number }}</span>
    </div>
    {% endif %}
  </div>
</section>
