<section class="section" id="insurance">
  <h2 class="section-title">Insurance Analysis</h2>

  {# ---- Homeowners Insurance ---- #}
  <h3>Homeowners Insurance</h3>
  <div class="card-grid">
    <div class="card">
      <span class="card-label">Annual Premium</span>
      <span class="card-value">{{ results.insurance.homeowners.annual_premium | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Monthly Premium</span>
      <span class="card-value">{{ results.insurance.homeowners.monthly_premium | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Coverage Amount</span>
      <span class="card-value">{{ results.insurance.homeowners.coverage_amount | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Deductible</span>
      <span class="card-value">{{ results.insurance.homeowners.deductible | currency }}</span>
    </div>
  </div>

  {# ---- Flood Insurance ---- #}
  {% if results.insurance.flood %}
  <h3>Flood Insurance</h3>
  <div class="card-grid">
    <div class="card">
      <span class="card-label">Flood Zone</span>
      <span class="card-value">{{ results.insurance.flood.flood_zone }}</span>
    </div>
    <div class="card">
      <span class="card-label">Annual Premium</span>
      <span class="card-value">{{ results.insurance.flood.annual_premium | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Coverage Amount</span>
      <span class="card-value">{{ results.insurance.flood.coverage_amount | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Required</span>
      <span class="card-value">
        {% if results.insurance.flood.required %}
          <span class="badge badge-negative">Required</span>
        {% else %}
          <span class="badge badge-positive">Optional</span>
        {% endif %}
      </span>
    </div>
  </div>
  {% endif %}

  {# ---- Natural Disaster Risk ---- #}
  <h3>Natural Disaster Risk Assessment</h3>
  <div class="card-grid">
    <div class="card">
      <span class="card-label">Earthquake Risk</span>
      <span class="card-value">
        <span class="badge {% if results.insurance.disaster_risk.earthquake_risk == 'low' %}badge-positive{% elif results.insurance.disaster_risk.earthquake_risk == 'moderate' %}badge-neutral{% elif results.insurance.disaster_risk.earthquake_risk == 'high' %}badge-negative{% else %}badge-unknown{% endif %}">
          {{ results.insurance.disaster_risk.earthquake_risk | title }}
        </span>
      </span>
    </div>
    <div class="card">
      <span class="card-label">Hurricane Risk</span>
      <span class="card-value">
        <span class="badge {% if results.insurance.disaster_risk.hurricane_risk == 'low' %}badge-positive{% elif results.insurance.disaster_risk.hurricane_risk == 'moderate' %}badge-neutral{% elif results.insurance.disaster_risk.hurricane_risk == 'high' %}badge-negative{% else %}badge-unknown{% endif %}">
          {{ results.insurance.disaster_risk.hurricane_risk | title }}
        </span>
      </span>
    </div>
    <div class="card">
      <span class="card-label">Wildfire Risk</span>
      <span class="card-value">
        <span class="badge {% if results.insurance.disaster_risk.wildfire_risk == 'low' %}badge-positive{% elif results.insurance.disaster_risk.wildfire_risk == 'moderate' %}badge-neutral{% elif results.insurance.disaster_risk.wildfire_risk == 'high' %}badge-negative{% else %}badge-unknown{% endif %}">
          {{ results.insurance.disaster_risk.wildfire_risk | title }}
        </span>
      </span>
    </div>
    <div class="card">
      <span class="card-label">Tornado Risk</span>
      <span class="card-value">
        <span class="badge {% if results.insurance.disaster_risk.tornado_risk == 'low' %}badge-positive{% elif results.insurance.disaster_risk.tornado_risk == 'moderate' %}badge-neutral{% elif results.insurance.disaster_risk.tornado_risk == 'high' %}badge-negative{% else %}badge-unknown{% endif %}">
          {{ results.insurance.disaster_risk.tornado_risk | title }}
        </span>
      </span>
    </div>
    <div class="card card-wide">
      <span class="card-label">Overall Risk Score</span>
      <div class="gauge">
        <div class="gauge-bar {% if results.insurance.disaster_risk.overall_risk_score <= 3 %}gauge-positive{% elif results.insurance.disaster_risk.overall_risk_score <= 6 %}gauge-neutral{% else %}gauge-negative{% endif %}"
             style="width: {{ results.insurance.disaster_risk.overall_risk_score * 10 }}%;">
          <span class="gauge-text">{{ results.insurance.disaster_risk.overall_risk_score }} / 10</span>
        </div>
      </div>
    </div>
  </div>

  {# ---- Insurance Cost Summary ---- #}
  <h3>Insurance Cost Summary</h3>
  <div class="card-grid">
    <div class="card">
      <span class="card-label">Total Annual Insurance</span>
      <span class="card-value">{{ results.insurance.total_annual_insurance | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Total Monthly Insurance</span>
      <span class="card-value">{{ results.insurance.total_monthly_insurance | currency }}</span>
    </div>
    <div class="card">
      <span class="card-label">Risk-Adjusted Monthly Cost</span>
      <span class="card-value">{{ results.insurance.risk_adjusted_monthly_cost | currency }}</span>
    </div>
  </div>
</section>
