<section class="section" id="tax">
  <h2 class="section-title">Tax Analysis</h2>

  {# ---- First Home Strategy ---- #}
  {% if results.tax.first_home_strategy %}
  <h3>First Home Strategy</h3>
  <div class="recommendation-box {% if results.tax.first_home_strategy.recommendation == 'sell' %}recommendation-sell{% elif results.tax.first_home_strategy.recommendation == 'rent' %}recommendation-rent{% else %}recommendation-either{% endif %}">
    <div class="recommendation-header">
      <span class="recommendation-label">Recommendation</span>
      <span class="badge {% if results.tax.first_home_strategy.recommendation == 'sell' %}badge-info{% elif results.tax.first_home_strategy.recommendation == 'rent' %}badge-positive{% else %}badge-neutral{% endif %}">
        {{ results.tax.first_home_strategy.recommendation | title }}
      </span>
    </div>
    <p class="recommendation-reason">{{ results.tax.first_home_strategy.recommendation_reason }}</p>

    <div class="strategy-comparison">
      {# ---- Sell Analysis ---- #}
      {% if results.tax.first_home_strategy.sell_analysis %}
      {% set sell = results.tax.first_home_strategy.sell_analysis %}
      <div class="strategy-card">
        <h4>Sell Analysis</h4>
        <div class="card-details-list">
          <div class="detail-row">
            <span>Purchase Price</span>
            <span>{{ sell.purchase_price | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Estimated Sale Price</span>
            <span>{{ sell.estimated_sale_price | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Selling Costs</span>
            <span>{{ sell.selling_costs | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Cost Basis</span>
            <span>{{ sell.cost_basis | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Gross Gain</span>
            <span class="{% if sell.gross_gain > 0 %}text-positive{% elif sell.gross_gain < 0 %}text-negative{% endif %}">
              {{ sell.gross_gain | currency }}
            </span>
          </div>
          <div class="detail-row">
            <span>Exclusion Amount</span>
            <span>{{ sell.exclusion_amount | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Taxable Gain</span>
            <span class="{% if sell.taxable_gain > 0 %}text-negative{% else %}text-positive{% endif %}">
              {{ sell.taxable_gain | currency }}
            </span>
          </div>
          <div class="detail-row">
            <span>Estimated Federal Tax</span>
            <span>{{ sell.estimated_federal_tax | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Primary Residence Test</span>
            <span class="{% if sell.meets_primary_residence_test %}text-positive{% else %}text-negative{% endif %}">
              {{ "Meets requirements" if sell.meets_primary_residence_test else "Does not meet requirements" }}
            </span>
          </div>
          <div class="detail-row">
            <span>Years Owned / Primary</span>
            <span>{{ sell.years_owned | number(1) }} / {{ sell.years_as_primary | number(1) }}</span>
          </div>
          <div class="detail-row total-row">
            <span><strong>Net Proceeds</strong></span>
            <span><strong>{{ sell.net_proceeds | currency }}</strong></span>
          </div>
        </div>
      </div>
      {% endif %}

      {# ---- Rent Analysis ---- #}
      {% if results.tax.first_home_strategy.rent_analysis %}
      {% set rent = results.tax.first_home_strategy.rent_analysis %}
      <div class="strategy-card">
        <h4>Rental Income Analysis</h4>
        <div class="card-details-list">
          <div class="detail-row">
            <span>Monthly Rent</span>
            <span>{{ rent.monthly_rent | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Monthly Mortgage</span>
            <span>{{ rent.monthly_mortgage | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Monthly Taxes</span>
            <span>{{ rent.monthly_taxes | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Monthly Insurance</span>
            <span>{{ rent.monthly_insurance | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Monthly Maintenance</span>
            <span>{{ rent.monthly_maintenance | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Vacancy Loss</span>
            <span>{{ rent.vacancy_loss_monthly | currency }}</span>
          </div>
          <div class="detail-row total-row">
            <span><strong>Monthly Cash Flow</strong></span>
            <span class="{% if rent.monthly_cash_flow > 0 %}text-positive{% else %}text-negative{% endif %}">
              <strong>{{ rent.monthly_cash_flow | currency }}</strong>
            </span>
          </div>
          <div class="detail-row">
            <span>Annual Cash Flow</span>
            <span class="{% if rent.annual_cash_flow > 0 %}text-positive{% else %}text-negative{% endif %}">
              {{ rent.annual_cash_flow | currency }}
            </span>
          </div>
          <div class="detail-row">
            <span>Annual Depreciation</span>
            <span>{{ rent.annual_depreciation | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Tax Benefit from Depreciation</span>
            <span class="text-positive">{{ rent.annual_tax_benefit_from_depreciation | currency }}</span>
          </div>
          <div class="detail-row">
            <span>Net Annual Return</span>
            <span class="{% if rent.net_annual_return > 0 %}text-positive{% else %}text-negative{% endif %}">
              {{ rent.net_annual_return | currency }}
            </span>
          </div>
          <div class="detail-row">
            <span>Cap Rate</span>
            <span>{{ rent.cap_rate | pct(2) }}</span>
          </div>
        </div>
      </div>
      {% endif %}
    </div>

    {# ---- Summary Comparison ---- #}
    <div class="strategy-summary">
      <div class="card-grid">
        <div class="card">
          <span class="card-label">Net Proceeds if Sold</span>
          <span class="card-value">{{ results.tax.first_home_strategy.sell_net_proceeds | currency }}</span>
        </div>
        <div class="card">
          <span class="card-label">Annual Net if Rented</span>
          <span class="card-value">{{ results.tax.first_home_strategy.rent_annual_net | currency }}</span>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {# ---- Mortgage Interest Deduction ---- #}
  <h3>Tax Deductions</h3>
  <div class="table-wrapper">
    <table class="table-narrow">
      <thead>
        <tr>
          <th>Deduction</th>
          <th>Details</th>
          <th>Annual Savings</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Mortgage Interest</td>
          <td>
            {{ results.tax.mortgage_interest_deduction.annual_interest_paid | currency }} paid,
            {{ results.tax.mortgage_interest_deduction.deductible_amount | currency }} deductible
            <br><small>Marginal rate: {{ results.tax.mortgage_interest_deduction.marginal_tax_rate | pct(0) }}</small>
          </td>
          <td class="text-positive"><strong>{{ results.tax.mortgage_interest_deduction.tax_savings | currency }}</strong></td>
        </tr>
        <tr>
          <td>Property Tax</td>
          <td>
            {{ results.tax.property_tax_deduction.annual_property_tax | currency }} paid,
            {{ results.tax.property_tax_deduction.deductible_amount | currency }} deductible
            {% if results.tax.property_tax_deduction.salt_cap_hit %}
            <br><span class="badge badge-warning">SALT Cap Reached ($10,000)</span>
            {% endif %}
          </td>
          <td class="text-positive"><strong>{{ results.tax.property_tax_deduction.tax_savings | currency }}</strong></td>
        </tr>
        <tr class="total-row">
          <td><strong>Total Annual Tax Benefit</strong></td>
          <td></td>
          <td class="text-positive"><strong>{{ results.tax.total_annual_tax_benefit | currency }}</strong></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card-grid">
    <div class="card">
      <span class="card-label">Effective Monthly Cost Reduction</span>
      <span class="card-value text-positive">{{ results.tax.effective_monthly_cost_reduction | currency }} / mo</span>
    </div>
    <div class="card">
      <span class="card-label">Total Annual Tax Benefit</span>
      <span class="card-value text-positive">{{ results.tax.total_annual_tax_benefit | currency }} / yr</span>
    </div>
  </div>
</section>
